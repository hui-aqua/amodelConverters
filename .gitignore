# Generated Blender scenes, renders, simulation caches and validation logs.
/output/

# Personal AquaSim input files; keep the folder structure and instructions.
/inputs/models/*
!/inputs/models/.gitkeep
/inputs/results/*
!/inputs/results/.gitkeep

# Large local AquaSim result export; supply separately for the replay example.
/examples/models/out.txt

# Local cases and their case-specific export helper (not bundled examples).
/examples/models/944ENR.amodel
/examples/models/ferdigModell.amodel
/examples/models/SLS_01.avz
/examples/models/extractNotd.bat

# Large local spreader models (>100 MB)
/assets/spreaders/wb/WB_spreader_still.obj

